{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tablica",
  "version": "0.0.0",
  "identifier": "io.github.arturmwnuk.tablica",
  "build": {
    "beforeDevCommand": "pnpm --filter @tablica/app dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @tablica/app build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tablica",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Education",
    "shortDescription": "Modular whiteboard for remote teaching",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 29
    }
  }
}
