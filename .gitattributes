# Jednolite końce linii (LF) na wszystkich platformach
* text=auto eol=lf

# Skrypty Windows wymagają CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Pliki binarne
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.woff binary
*.woff2 binary
*.jks binary
*.keystore binary
