{
  "name": "tablica-monorepo",
  "private": true,
  "version": "0.0.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tablica/app dev",
    "build:web": "pnpm --filter @tablica/app build",
    "tauri": "tauri",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @tablica/app typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "node --test e2e-app/smoke.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:licenses:rust": "cargo deny --manifest-path src-tauri/Cargo.toml check licenses",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:licenses && pnpm build:web && pnpm test:e2e && pnpm lint:rust && pnpm test:rust"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/selenium-webdriver": "4.35.7",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "selenium-webdriver": "4.52.0",
    "svelte": "5.57.3",
    "svelte-eslint-parser": "1.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
